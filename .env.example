# Public base URL used to build share links, e.g. https://wishtale.in
APP_URL=http://localhost:3000

# Postgres connection string. Leave empty in development to use an embedded
# PGlite database stored in .data/db (no server needed).
DATABASE_URL=

# Object storage (Cloudflare R2 or S3). Leave empty in development to store
# uploads on disk in .data/uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Razorpay. Leave empty in development to use the mock provider, which
# simulates the webhook through the same verification code path.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# One-time code for creating the first admin (owner) account at /admin.
# Pick any long random value; it's only used while no admin accounts exist.
ADMIN_SETUP_CODE=
